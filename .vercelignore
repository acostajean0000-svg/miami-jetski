# ============================================================
# Vercel Ignore — exclude dev/pipeline files from production deploy
# ============================================================
# Keeps Vercel uploads small and prevents exposing internal data
# at predictable URLs (e.g. /broward_phase1_plan.json).
#
# Anything NOT listed here gets deployed. The runtime essentials —
# *.html, operators.json, operators-slim.json, slug-map.js,
# referral.js, sitemap.xml, robots.txt, manifest.json, favicon.ico,
# *.png, images/ — all stay.
# ============================================================

# --- Build pipeline outputs (mirror sweep state) ------------
*_phase1_plan.json
*_phase2_*.json
*_phase3_records.json
*_filtered.json
*_to_delete.json
*_restore_slugs.json
phase1_plan.json
phase3_new_records.json

# --- Availability + scrape scratch --------------------------
availability_delete_backup.json
availability_restore_set.json
fh_scrape_photos.json

# --- Audit / planning artifacts -----------------------------
broken_urls.json
card_audit.json
diversification_plan.json
